{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Equipo",
  "version": "0.1.0",
  "identifier": "com.tiagoccepp.equipo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:bg",
    "beforeBuildCommand": "npm run build:before"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Equipo — tu equipo IA",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": true,
        "focus": true
      },
      {
        "label": "orb",
        "title": "Orbe",
        "url": "orb.html",
        "width": 148,
        "height": 148,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "closable": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../server", "../node_modules", "../shared"],
    "externalBin": ["binaries/equipo-node"],
    "category": "Productivity",
    "shortDescription": "Tu equipo IA en el escritorio",
    "longDescription": "Equipo: conversá por voz o texto con empleados IA. Orbe flotante, bandeja, permisos por niveles y control de la computadora."
  }
}
