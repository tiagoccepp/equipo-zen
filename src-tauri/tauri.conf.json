{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "J.A.B.S",
  "version": "0.1.0",
  "identifier": "com.tiagoccepp.equipo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:bg",
    "beforeBuildCommand": "npm run build:before"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "J.A.B.S — Pablo at your service",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": true,
        "focus": true
      },
      {
        "label": "orb",
        "title": "Orb",
        "url": "orb.html",
        "width": 200,
        "height": 264,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "closable": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../server", "../node_modules", "../shared", "../models", "../dist"],
    "externalBin": ["binaries/equipo-node"],
    "category": "Productivity",
    "shortDescription": "Just A Better System — your local-first AI team on the desktop",
    "longDescription": "J.A.B.S (Just A Better System): talk by voice or text with AI agent teams. Projects, parallel work with verification, a 3D stage, floating orb, tray, tiered permissions, and computer control — local-first."
  }
}
