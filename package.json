{
  "name": "reunion-dos-agentes-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:tts\" \"npm:dev:stt\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:bg": "concurrently npm:dev:server npm:dev:client",
    "build": "tsc && vite build",
    "build:before": "node scripts/desktop/before-build.mjs",
    "build:desktop": "sh scripts/desktop/build.sh",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev:tts": "sh -c '.venv-tts/bin/supertonic serve --host 127.0.0.1 --port 7788 || echo \"[tts] Supertonic no instalado (ver README); la reunión corre sin voz\"'",
    "dev:stt": "sh -c '.venv-tts/bin/python server/stt/whisper_server.py || echo \"[stt] Whisper local no disponible (ver README); se usa el navegador\"'",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "concurrently": "^10.0.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "nanoid": "^5.1.6",
    "node-edge-tts": "^1.2.12",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
