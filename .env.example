# ── Claves Gemini ────────────────────────────────────────────────────────
# Lista separada por comas (recomendado: 6 para rotación/failover)...
GEMINI_API_KEYS=clave1,clave2,clave3,clave4,clave5,clave6
# ...o numeradas: GEMINI_API_KEY_1 ... GEMINI_API_KEY_6
# Fallback (solo si no hay ninguna de las anteriores): GOOGLE_API_KEY / GEMINI_API_KEY
# Sin claves la app corre en modo simulación (respuestas enlatadas, sin API).

# ── Servidor ─────────────────────────────────────────────────────────────
PORT=8787
# HOST=127.0.0.1                       # bind (loopback por defecto; no exponer a la LAN)
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DB_PATH=server/data/meetings.db      # SQLite (WAL); override para tests

# ── Modelos (validados al arrancar contra models.list) ───────────────────
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_AGENT_LIVE_MODEL=             # modelo Live de los agentes (default: GEMINI_LIVE_MODEL)
# GEMINI_AGENT_TEXT_MODEL=gemini-2.5-flash
# GEMINI_ROUTER_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# GEMINI_LEARNING_MODEL=gemini-3.1-flash-lite

# ── Tiempo real ──────────────────────────────────────────────────────────
# AGENT_BACKEND=auto                   # auto (live→stream→mock) | live | stream | mock
# LIVE_MAX_SESSIONS_PER_KEY=2          # sesiones Live simultáneas por clave
# LIVE_IDLE_CLOSE_MS=300000            # cerrar sesión Live tras 5 min sin hablar (costo)
# SPEECH_LANGUAGE_CODE=es-ES           # voz de los agentes Live

# ── Timeouts (ms) ────────────────────────────────────────────────────────
# GEMINI_AGENT_TEXT_TIMEOUT_MS=8500
# GEMINI_ROUTER_TIMEOUT_MS=4500
# GEMINI_TTS_TIMEOUT_MS=12000

# ── Auto-aprendizaje (kill-switches: 0 desactiva) ────────────────────────
# LEARNING_ENABLED=1                   # observador de aprendizajes
# REFLECTION_ENABLED=1                 # resumen + título post-reunión
# ROUTER_TUNING_ENABLED=1              # sugerencias/vocabulario del router
# ROUTER_AUTO_APPLY_VOCAB=1            # auto-aplicar SOLO vocabulario aditivo
