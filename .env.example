# ── MiniMax (razonamiento de los agentes) ────────────────────────────────
# Clave de https://platform.minimax.io — sin clave la app corre en modo
# simulación (respuestas enlatadas, sin API).
MINIMAX_API_KEY=
# MINIMAX_API_KEYS=clave1,clave2        # opcional: varias con rotación
# MINIMAX_API_URL=https://api.minimax.io/v1/chat/completions
# MINIMAX_MODEL=MiniMax-M2.5            # también: MiniMax-M2, M2.7, M3
# MINIMAX_ROUTER_MODEL=                 # default: MINIMAX_MODEL
# MINIMAX_LEARNING_MODEL=               # default: MINIMAX_MODEL

# ── Supertonic (voz local, sin nube) ─────────────────────────────────────
# Setup una vez:  python3 -m venv .venv-tts && .venv-tts/bin/pip install 'supertonic[serve]'
# npm run dev lo levanta solo en el puerto 7788.
# SUPERTONIC_URL=http://127.0.0.1:7788
# SUPERTONIC_LANGUAGE=es                # 31 idiomas soportados

# ── Whisper local (transcripción de tu voz, open source de OpenAI) ───────
# Mismo venv: .venv-tts/bin/pip install faster-whisper fastapi uvicorn
# npm run dev lo levanta solo en el puerto 7789 (descarga el modelo al 1er uso).
# WHISPER_MODEL=small                   # base | small | medium | large-v3-turbo
# WHISPER_URL=http://127.0.0.1:7789
# GROQ_API_KEY=                         # alternativa cloud para STT (Ajustes → Oído)

# Nota: todo lo de esta sección y las claves se pueden gestionar desde la
# UI (⚙ Ajustes); lo guardado ahí pisa a estas variables.

# ── Servidor ─────────────────────────────────────────────────────────────
PORT=8787
# HOST=127.0.0.1                        # loopback por defecto; no exponer a la LAN
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DB_PATH=server/data/meetings.db       # SQLite (WAL)

# ── Timeouts (ms) ────────────────────────────────────────────────────────
# AGENT_TEXT_TIMEOUT_MS=20000
# ROUTER_TIMEOUT_MS=6000
# TTS_TIMEOUT_MS=12000

# ── Auto-aprendizaje (kill-switches: 0 desactiva) ────────────────────────
# LEARNING_ENABLED=1
# REFLECTION_ENABLED=1
# ROUTER_TUNING_ENABLED=1
# ROUTER_AUTO_APPLY_VOCAB=1

# ── Empresa digital (workforce + paciencia conversacional) ───────────────
# WORKFORCE_TICK_MS=5000            # cada cuánto busca trabajo pendiente
# WORKFORCE_MAX_CONCURRENT=2        # corridas de trabajo en paralelo
# WORKFORCE_STEP_TIMEOUT_MS=180000  # timeout por paso del empleado
# USER_TURN_SETTLE_MS=2600          # espera antes de responder (fragmentos)
# USER_TURN_SETTLE_EXTENDED_MS=6000 # espera si la frase quedó abierta
