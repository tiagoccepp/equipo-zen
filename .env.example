# Gemini Developer API keys. You can use either one comma-separated list
# or individual GEMINI_API_KEY_1...GEMINI_API_KEY_6 variables.
GEMINI_API_KEYS=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=

# Models
GEMINI_LIVE_MODEL=gemini-2.0-flash-preview
GEMINI_TRANSCRIBE_MODEL=gemini-2.0-flash-preview
GEMINI_AGENT_TEXT_MODEL=gemini-2.5-flash
GEMINI_ROUTER_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.0-flash-preview-tts

# Backend WebSocket/HTTP port.
PORT=8787
